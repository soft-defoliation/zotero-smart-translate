{
  "name": "smart-translate-for-zotero",
  "version": "1.2.0",
  "description": "AI-powered Zotero reading assistant: translation, summarization, innovation extraction, method structuring.",
  "author": "Feng Qiu",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/soft-defoliation/zotero-smart-translate.git"
  },
  "type": "module",
  "scripts": {
    "dev": "zotero-plugin dev",
    "build": "zotero-plugin build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "release": "zotero-plugin release"
